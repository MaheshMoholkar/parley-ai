# Copy to .env for local runs outside Docker.
PARLEY_DATABASE_URL=postgresql+psycopg://parley:parley@localhost:5432/parley
PARLEY_TEST_DATABASE_URL=postgresql+psycopg://parley:parley@localhost:5432/parley_test
PARLEY_SYNC_INTERVAL_MINUTES=60
PARLEY_WORKER_POLL_SECONDS=30
PARLEY_LOG_LEVEL=INFO

# Model and email (see README "Turning on the model and email")
PARLEY_MODEL_PROVIDER=template
PARLEY_AWS_REGION=ap-south-1
PARLEY_CHANNEL=dry_run
PARLEY_EMAIL_FROM=reminders@example.com
PARLEY_REPLY_DOMAIN=replies.example.com
PARLEY_INBOUND_SECRET=
