{"id": "evasive", "input": {"description": "You avoid committing. You reply vaguely ('will see', 'busy right now', 'soon') and never give a date or pay."}, "expected": {"final_states": ["needs_human"], "must_have": []}, "split": "test", "tags": ["evasive"]}
{"id": "promise_breaker", "input": {"description": "You always promise a specific date two or three days ahead, sound sincere, and never pay. When reminded again, you apologise and promise a new date."}, "expected": {"final_states": ["promised", "scheduled", "awaiting_reply", "needs_human"], "must_have": ["promise_broken"]}, "split": "test", "tags": ["promise_breaker"]}
{"id": "disputer", "input": {"description": "You say the goods arrived damaged and the invoice is wrong. You refuse to pay until it is corrected."}, "expected": {"final_states": ["needs_human"], "must_have": ["review_dispute"]}, "split": "test", "tags": ["disputer"]}
{"id": "already_paid", "input": {"description": "You paid on 2 January by NEFT (UTR 403912345678) and are annoyed to be reminded. You say so and give the UTR.", "paid_before_start": true}, "expected": {"final_states": ["needs_human"], "must_have": ["verify_payment", "payment_found"]}, "split": "test", "tags": ["already_paid"]}
